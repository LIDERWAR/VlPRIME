# Реквизиты доступа к серверу vlprime.ru (Reg.ru)
# Скопируйте этот файл в .env и заполните свои данные.
# Файл .env добавлен в .gitignore и никогда не попадет в репозиторий.

# Протокол: sftp (рекомендуется) или ftp
DEPLOY_PROTOCOL=sftp

# Адрес сервера (IP или домен)
DEPLOY_HOST=31.31.196.159

# Порт: 22 для SFTP/SSH, 21 для FTP
DEPLOY_PORT=22

# Имя пользователя на хостинге
DEPLOY_USER=your_username

# Пароль пользователя
DEPLOY_PASSWORD=your_password

# Путь к папке темы на сервере
# Обычно: /var/www/uXXXXXXX/data/www/vlprime.ru/wp-content/themes/vlprime
# или: public_html/wp-content/themes/vlprime
DEPLOY_REMOTE_PATH=/var/www/uXXXXXXX/data/www/vlprime.ru/wp-content/themes/vlprime
